# reachy-aiden configuration
#
# Copy this file to "companion.env" in the same folder, fill in your values,
# then run install.sh. The installer copies it to
# /etc/reachy-companion/companion.env on the robot (readable by root and the
# pollen user only). Edit that copy later and run "sudo companion-reapply".
#
# Never commit companion.env to Git. It holds your API keys.
#
# Format: one KEY=value per line, no spaces around "=". Put any value that
# contains spaces or an apostrophe in double quotes, for example
# OWNER_NAME="Sam O'Neil".

# ---------------------------------------------------------------------------
# Who is who
# ---------------------------------------------------------------------------
# Your robot's name. Also the name of its profile folder in
# /home/pollen/profiles/. One word, letters only works best.
ROBOT_NAME=Aiden

# What the robot calls you. Used in tool descriptions and memory transcripts.
OWNER_NAME="Your Name"

# Words the robot speaks when a new session opens. A fixed greeting tells you
# at a glance that the session is alive. Leave empty to turn it off.
COMPANION_GREETING="Hello world."

# ---------------------------------------------------------------------------
# Voice backend (switch later with: companion-switch openai|huggingface|gemini)
# ---------------------------------------------------------------------------
# huggingface = Pollen Robotics' hosted server. No API key needed. Default.
# openai      = OpenAI Realtime. Needs OPENAI_API_KEY. Billed per use.
# gemini      = Google Gemini Live. Needs GEMINI_API_KEY.
BACKEND_PROVIDER=huggingface

# Hugging Face connection mode. "deployed" sends audio to Pollen's cloud
# server. "local" sends it to your own server at HF_REALTIME_WS_URL.
# The provider name alone does not tell you where traffic goes; this does.
HF_REALTIME_CONNECTION_MODE=deployed
HF_REALTIME_WS_URL=

# From https://huggingface.co/settings/tokens (a free "Read" token).
# Optional for the deployed server, but a 401 Unauthorized error in the
# logs usually means this token is missing or expired.
HF_TOKEN=

# From https://platform.openai.com/api-keys
# Needed for the OpenAI backend AND for the nightly memory summarizer.
OPENAI_API_KEY=

# From https://aistudio.google.com/apikey  (Gemini backend only)
GEMINI_API_KEY=

# Model names. Leave empty to use the conversation app's defaults.
OPENAI_MODEL=gpt-realtime-2.1
GEMINI_MODEL=

# Voice for each backend. These are written to the profile's voice.txt
# whenever you switch.
VOICE_OPENAI=cedar
VOICE_HUGGINGFACE=Aiden
VOICE_GEMINI=Kore

# ---------------------------------------------------------------------------
# Turn-taking (how long the robot waits after you stop talking)
# ---------------------------------------------------------------------------
# Raise the silence values if the robot cuts you off. Raise the threshold
# (0.0 to 1.0) if background noise makes it think you are speaking.
OPENAI_SILENCE_MS=800
OPENAI_VAD_THRESHOLD=0.7
HF_SILENCE_MS=1200
HF_PREFIX_PADDING_MS=300
HF_VAD_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
# Set to 0 to turn off conversation logging and memory extraction entirely.
MEMORY_ENABLED=1
# Model used once a day to turn the conversation log into memories.
SUMMARIZER_MODEL=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Weather tool default location (used when no city is named)
# ---------------------------------------------------------------------------
WEATHER_LOCATION_NAME="Your City, Your State"
WEATHER_LATITUDE=0.0
WEATHER_LONGITUDE=0.0
# fahrenheit or celsius
WEATHER_UNITS=fahrenheit

# ---------------------------------------------------------------------------
# Optional: Google Calendar tool (see extras/calendar/README.md)
# ---------------------------------------------------------------------------
CALENDAR_TIMEZONE=America/New_York
CALENDAR_ID=primary
